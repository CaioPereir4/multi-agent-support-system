<mxfile host="app.diagrams.net" agent="generate_diagrams.py" version="24.7.17" type="device"><diagram id="deployment" name="1. AWS deployment (EKS)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Getnet Multi-Agent Support System - deployment on AWS" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="The pod carries no credentials: it assumes an IAM role through IRSA and reads the Tavily key from Secrets Manager." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#5A6C7D;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1000" height="24" as="geometry"/></mxCell><mxCell id="cloud" value="AWS Cloud - sa-east-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="220" y="110" width="1320" height="700" as="geometry"/></mxCell><mxCell id="vpc" value="VPC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#248814;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#248814;" vertex="1" parent="1"><mxGeometry x="390" y="165" width="750" height="620" as="geometry"/></mxCell><mxCell id="subpub" value="Public subnet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="415" y="205" width="240" height="145" as="geometry"/></mxCell><mxCell id="subpriv" value="Private subnets - multi AZ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="415" y="380" width="700" height="380" as="geometry"/></mxCell><mxCell id="eks" value="Amazon EKS cluster" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="575" y="415" width="520" height="330" as="geometry"/></mxCell><mxCell id="ext" value="Outside AWS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C7D;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#5A6C7D;" vertex="1" parent="1"><mxGeometry x="390" y="840" width="750" height="130" as="geometry"/></mxCell><mxCell id="client" value="Merchant channel&lt;br&gt;web / mobile / Postman" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#5A6C7D;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="150" height="70" as="geometry"/></mxCell><mxCell id="apigw" value="Amazon API Gateway&lt;br&gt;HTTP API + WAF" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="272" y="420" width="64" height="64" as="geometry"/></mxCell><mxCell id="nat" value="NAT Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nat_gateway;" vertex="1" parent="1"><mxGeometry x="470" y="240" width="64" height="64" as="geometry"/></mxCell><mxCell id="nlb" value="Internal NLB" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.network_load_balancer;" vertex="1" parent="1"><mxGeometry x="445" y="440" width="64" height="64" as="geometry"/></mxCell><mxCell id="svc" value="Service (ClusterIP)&lt;br&gt;getnet-support-api" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="600" y="450" width="190" height="52" as="geometry"/></mxCell><mxCell id="pod1" value="Pod - getnet-support-api&lt;br&gt;uvicorn + FastAPI&lt;br&gt;in-memory vector index" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;fontSize=10;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="600" y="535" width="190" height="78" as="geometry"/></mxCell><mxCell id="pod2" value="Pod - getnet-support-api&lt;br&gt;uvicorn + FastAPI&lt;br&gt;in-memory vector index" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;fontSize=10;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="815" y="535" width="190" height="78" as="geometry"/></mxCell><mxCell id="irsa" value="ServiceAccount -&gt; IRSA role&lt;br&gt;bedrock:InvokeModel . secretsmanager:GetSecretValue" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=10;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="600" y="645" width="405" height="62" as="geometry"/></mxCell><mxCell id="vpce" value="VPC endpoints&lt;br&gt;(PrivateLink)&lt;br&gt;bedrock-runtime&lt;br&gt;secretsmanager" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontSize=10;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="960" y="215" width="160" height="110" as="geometry"/></mxCell><mxCell id="bedrock" value="Amazon Bedrock&lt;br&gt;Claude Sonnet 4.5&lt;br&gt;Titan Embed v2 (256d)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1240" y="200" width="64" height="64" as="geometry"/></mxCell><mxCell id="secrets" value="Secrets Manager&lt;br&gt;TAVILY_API_KEY" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="1240" y="360" width="64" height="64" as="geometry"/></mxCell><mxCell id="cw" value="CloudWatch&lt;br&gt;logs . metrics . alarms" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1240" y="505" width="64" height="64" as="geometry"/></mxCell><mxCell id="ecr" value="Amazon ECR&lt;br&gt;getnet-support-system" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_container_registry;" vertex="1" parent="1"><mxGeometry x="1240" y="650" width="64" height="64" as="geometry"/></mxCell><mxCell id="tavily" value="Tavily API&lt;br&gt;search . crawl . extract" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#5A6C7D;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="415" y="880" width="200" height="68" as="geometry"/></mxCell><mxCell id="site" value="site.getnet.com.br&lt;br&gt;ingestion source" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#5A6C7D;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="645" y="880" width="200" height="68" as="geometry"/></mxCell><mxCell id="ls" value="LangSmith&lt;br&gt;tracing (optional)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#5A6C7D;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="875" y="880" width="200" height="68" as="geometry"/></mxCell><mxCell id="note" value="GET /api/health is the liveness probe:&lt;br&gt;200 while the index is still building,&lt;br&gt;with the knowledge-base state in the body." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D9A400;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#3B3B3B;" vertex="1" parent="1"><mxGeometry x="1180" y="790" width="350" height="78" as="geometry"/></mxCell><mxCell id="deployment-e0" value="POST /api/chat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="client" target="apigw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deployment-e1" value="VPC Link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apigw" target="nlb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deployment-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nlb" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deployment-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="svc" target="pod1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deployment-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="svc" target="pod2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deployment-e5" value="InvokeModel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pod2" target="vpce"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deployment-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vpce" target="bedrock"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deployment-e7" value="GetSecretValue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vpce" target="secrets"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deployment-e8" value="egress" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pod1" target="nat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deployment-e9" value="search / crawl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nat" target="tavily"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deployment-e10" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tavily" target="site"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deployment-e11" value="structured logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#E7157B;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pod2" target="cw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="deployment-e12" value="image pull" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#ED7100;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ecr" target="pod2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="internals" name="2. Agent internals"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Internals - LangGraph orchestration, nodes, tools and RAG" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="One router decides the plan and the language; specialists run in parallel; the synthesizer merges only when there is something to merge." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#5A6C7D;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1000" height="24" as="geometry"/></mxCell><mxCell id="graph" value="LangGraph StateGraph" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="1080" height="520" as="geometry"/></mxCell><mxCell id="raglane" value="RAG pipeline - src/rag/vector_store.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7AA116;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1500" height="210" as="geometry"/></mxCell><mxCell id="api" value="FastAPI - main.py&lt;br&gt;POST /api/chat -&gt; chat_service&lt;br&gt;GET /api/health -&gt; vector_store.status()&lt;br&gt;lifespan -&gt; refresh_periodically()" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="380" height="120" as="geometry"/></mxCell><mxCell id="pipe" value="pipeline.run_agent&lt;br&gt;graph compiled once per process" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="380" height="62" as="geometry"/></mxCell><mxCell id="state" value="AgentState (TypedDict, extends LangChain AgentState)&lt;br&gt;&lt;br&gt;user_message : str&lt;br&gt;user_id : str | None&lt;br&gt;language : str | None&lt;br&gt;selected_agents : list[knowledge | customer_support]&lt;br&gt;knowledge_result : str | None&lt;br&gt;customer_support_result : str | None&lt;br&gt;final_response : str | None&lt;br&gt;messages : list[AnyMessage]&lt;br&gt;&lt;br&gt;The same schema drives the outer graph and the&lt;br&gt;support agent's inner loop - which is how user_id&lt;br&gt;reaches the tools without passing through the model." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF6FF;strokeColor=#147EBA;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#3B3B3B;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="380" height="260" as="geometry"/></mxCell><mxCell id="start" value="START" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="495" y="140" width="84" height="38" as="geometry"/></mxCell><mxCell id="router" value="router_node&lt;br&gt;with_structured_output(RoutingDecision)&lt;br&gt;-&gt; agents + BCP-47 language" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="640" y="128" width="290" height="66" as="geometry"/></mxCell><mxCell id="kn" value="knowledge_node&lt;br&gt;create_agent(...)&lt;br&gt;knowledge base first, web as fallback" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#01A88D;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="545" y="275" width="250" height="80" as="geometry"/></mxCell><mxCell id="cs" value="customer_support_node&lt;br&gt;create_agent(state_schema=AgentState)&lt;br&gt;user_id injected from state" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="880" y="275" width="280" height="80" as="geometry"/></mxCell><mxCell id="syn" value="synthesizer_node&lt;br&gt;1 finding -&gt; passthrough (0 LLM calls)&lt;br&gt;2 findings -&gt; merge (1 LLM call)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="680" y="450" width="300" height="80" as="geometry"/></mxCell><mxCell id="end" value="END" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1240" y="470" width="84" height="38" as="geometry"/></mxCell><mxCell id="kntools" value="Knowledge Agent tools&lt;br&gt;&lt;br&gt;knowledge_base_search(query)&lt;br&gt;   ok | no_relevant_results | knowledge_base_unavailable&lt;br&gt;web_search(query, restrict_to_getnet)&lt;br&gt;   ok | no_relevant_results | web_search_failed&lt;br&gt;&lt;br&gt;middleware ToolCallLimit: 4 calls per run, 1 for the KB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#01A88D;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#3B3B3B;" vertex="1" parent="1"><mxGeometry x="460" y="650" width="500" height="200" as="geometry"/></mxCell><mxCell id="cstools" value="Customer Support Agent tools&lt;br&gt;&lt;br&gt;get_merchant_profile()&lt;br&gt;get_recent_transactions(days)&lt;br&gt;get_settlement_schedule(days_back)&lt;br&gt;get_terminal_diagnostics(serial_number)&lt;br&gt;open_support_ticket(category, summary, priority)&lt;br&gt;&lt;br&gt;merchant id read from ToolRuntime.state, never from the model" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#3B3B3B;" vertex="1" parent="1"><mxGeometry x="1000" y="650" width="540" height="200" as="geometry"/></mxCell><mxCell id="refresh" value="Refresh loop&lt;br&gt;&lt;br&gt;The FastAPI lifespan starts refresh_periodically():&lt;br&gt;a full re-index every 24h. A failed refresh keeps the&lt;br&gt;previous index serving and the reason lands in&lt;br&gt;/api/health -&gt; last_error." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D9A400;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#3B3B3B;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="390" height="120" as="geometry"/></mxCell><mxCell id="ing" value="1. Ingest&lt;br&gt;TavilyCrawl (depth 2, 20 pages)&lt;br&gt;+ TavilyExtract (7 curated URLs)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2FBF2;strokeColor=#7AA116;fontSize=10;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="930" width="240" height="80" as="geometry"/></mxCell><mxCell id="dedup" value="2. Deduplicate&lt;br&gt;by URL&lt;br&gt;(sources overlap)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2FBF2;strokeColor=#7AA116;fontSize=10;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="340" y="930" width="170" height="80" as="geometry"/></mxCell><mxCell id="split" value="3. Split&lt;br&gt;recursive splitter&lt;br&gt;1200 chars / 150 overlap" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2FBF2;strokeColor=#7AA116;fontSize=10;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="540" y="930" width="190" height="80" as="geometry"/></mxCell><mxCell id="emb" value="4. Embed&lt;br&gt;Titan Embed v2&lt;br&gt;256 dims, normalised" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2FBF2;strokeColor=#7AA116;fontSize=10;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="760" y="930" width="190" height="80" as="geometry"/></mxCell><mxCell id="store" value="5. Store&lt;br&gt;InMemoryVectorStore&lt;br&gt;swapped atomically under a lock" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2FBF2;strokeColor=#7AA116;fontSize=10;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="980" y="930" width="230" height="80" as="geometry"/></mxCell><mxCell id="retr" value="6. Retrieve&lt;br&gt;top_k*2 -&gt; drop score &lt; 0.35&lt;br&gt;max 2 chunks/URL -&gt; 4 x 600 chars" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2FBF2;strokeColor=#7AA116;fontSize=10;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1240" y="930" width="270" height="80" as="geometry"/></mxCell><mxCell id="internals-e0" value="invoke(state)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pipe" target="start"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="internals-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="start" target="router"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="internals-e2" value="knowledge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="router" target="kn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="internals-e3" value="customer_support" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#6B7885;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="router" target="cs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="internals-e4" value="